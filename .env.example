# ==============================================================================
# BloodConnect Environment Configuration (.env.example)
# Copy this file to .env for local development:
#   cp .env.example .env
#
# For production deployment on Vercel:
#   Configure these variables in Vercel Project Settings > Environment Variables
# ==============================================================================

# Flask Secret Key for session cookies and flash messages
# Generate a strong key in Python: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secure-flask-secret-key-min-32-chars

# Database Connection URL
# ------------------------------------------------------------------------------
# For Local Development (SQLite):
# Leave blank to use default 'bloodconnect.db', or set a custom path:
# BLOODCONNECT_DB=bloodconnect.db
#
# For Production (Hosted PostgreSQL):
# Supply your PostgreSQL connection string from Neon, Supabase, Vercel Postgres, or AWS RDS:
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
DATABASE_URL=postgresql://postgres_user:postgres_password@ep-sample-host.region.neon.tech/bloodconnect_db?sslmode=require

# Public Base Origin URL
# ------------------------------------------------------------------------------
# Used for generating persistent, public HTTPS links encoded into donor QR codes
# and digital ID profile preview buttons.
#
# Leave empty for local development (defaults to http://127.0.0.1:5000).
# In Vercel, VERCEL_PROJECT_PRODUCTION_URL is detected automatically, or you can
# explicitly specify your custom production domain here:
PUBLIC_BASE_URL=https://your-bloodconnect-app.vercel.app

# Flask Environment Flags
FLASK_ENV=production
FLASK_DEBUG=0
